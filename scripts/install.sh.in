#!/bin/sh
# Verifies an RSA signature over the release manifest before installing
# anything. This script ships on the project's release page, independent of any
# relay mirror it may download binaries from.
set -eu

# Where the artifacts live, flat (manifest.json + binaries side by side).
# Explicit env wins; a relay's /dl mirror next; then the release page this
# installer was built for.
# A relay serving this script rewrites the empty string below to its own public
# origin, so `curl https://relay/install.sh | sh` installs from that relay with
# nothing exported. The release build leaves it empty, and a copy taken from the
# release page keeps pointing at the release page.
RELAY_SELF=""
BASE=${WANCTL_DIST_BASE:-}
if [ -z "$BASE" ]; then
  RELAY=${WANCTL_RELAY:-$RELAY_SELF}
  if [ -n "$RELAY" ]; then BASE=${RELAY%/}/dl; else BASE="@WANCTL_RELEASE_BASE@"; fi
fi
if [ -z "$BASE" ]; then
  RELAY="@WANCTL_DEFAULT_RELAY@"
  [ -n "$RELAY" ] && BASE=${RELAY%/}/dl
fi
[ -n "$BASE" ] || { echo "set WANCTL_DIST_BASE (or WANCTL_RELAY) to where the release artifacts live" >&2; exit 1; }
# Everything below is written for the shell and utilities a stripped busybox
# gives a router: no `tr` character classes, no `od`, no `install`. The two
# tools that are genuinely required are named up front with the package that
# provides them.
command -v curl >/dev/null 2>&1 || {
  echo "curl is required to download the release" >&2
  [ -x /bin/opkg ] && echo "on OpenWrt: opkg install curl openssl-util" >&2
  exit 1
}
command -v openssl >/dev/null 2>&1 || {
  echo "openssl is required to verify the release signature" >&2
  [ -n "${PREFIX:-}" ] && [ -x "$PREFIX/bin/pkg" ] && echo "on Termux: pkg install openssl-tool" >&2
  [ -x /bin/opkg ] && echo "on OpenWrt: opkg install openssl-util" >&2
  exit 1
}
TMPDIR_WANCTL=$(mktemp -d)
trap 'rm -rf "$TMPDIR_WANCTL"' EXIT HUP INT TERM

cat >"$TMPDIR_WANCTL/release.pub" <<'WANCTL_RELEASE_KEY'
@WANCTL_RELEASE_RSA_PUBLIC_KEY_PEM@
WANCTL_RELEASE_KEY

curl -fL --proto '=https' --proto-redir '=https' --tlsv1.2 --max-filesize 1048576 \
  "$BASE/manifest.json" -o "$TMPDIR_WANCTL/manifest.json"
curl -fL --proto '=https' --proto-redir '=https' --tlsv1.2 --max-filesize 1024 \
  "$BASE/manifest.json.rsa.sig" -o "$TMPDIR_WANCTL/manifest.json.rsa.sig"
# `dgst -verify` rather than `pkeyutl -rawin`: the latter is Ed25519-only and
# absent from the LibreSSL that macOS ships as /usr/bin/openssl, which made this
# script fail on any Mac without a separately installed OpenSSL.
openssl dgst -sha256 -verify "$TMPDIR_WANCTL/release.pub" \
  -signature "$TMPDIR_WANCTL/manifest.json.rsa.sig" "$TMPDIR_WANCTL/manifest.json" >/dev/null

VERSION=$(awk '/"version":/ { gsub(/[",]/, "", $2); print $2; found++ } END { if (found != 1) exit 1 }' "$TMPDIR_WANCTL/manifest.json") || { echo "signed manifest has no unique version" >&2; exit 1; }
version_gt() {
  new=${1#v}; old=${2#v}; oldifs=$IFS; IFS=.; set -- $new $old; IFS=$oldifs
  [ "$#" -eq 6 ] || return 1
  for n in "$@"; do case "$n" in ''|*[!0-9]*) return 1 ;; esac; done
  [ "$1" -gt "$4" ] || { [ "$1" -eq "$4" ] && { [ "$2" -gt "$5" ] || { [ "$2" -eq "$5" ] && [ "$3" -gt "$6" ]; }; }; }
}
EXISTING=$(command -v wanctl 2>/dev/null || true)
if [ -n "$EXISTING" ]; then
  CURRENT=$($EXISTING version 2>/dev/null || true)
  if [ -n "$CURRENT" ] && [ "$CURRENT" != dev ] && ! version_gt "$VERSION" "$CURRENT"; then
    echo "refusing release $VERSION: installed version is $CURRENT" >&2
    exit 1
  fi
fi

# Not `tr '[:upper:]' '[:lower:]'`: a busybox built without character classes
# (OpenWrt's is) treats those as literal sets and turns "Linux" into "Linlx",
# which then matches nothing in the manifest.
case "$(uname -s)" in
  Linux) OS=linux ;;
  Darwin) OS=darwin ;;
  *) echo "unsupported operating system: $(uname -s) (wanctl ships linux, darwin, windows and android)" >&2; exit 1 ;;
esac
# Android reports itself as Linux through `uname -s` — the kernel is Linux — but
# it needs the android artifact, which carries the DNS fallback that a phone
# cannot work without. `uname -o` says Android under Termux; app_process is the
# Android runtime binary and exists on every Android device, which covers shells
# whose uname has no -o (busybox, adb shell).
if [ "$OS" = linux ] && { [ "$(uname -o 2>/dev/null)" = Android ] || [ -x /system/bin/app_process ] || [ -x /system/bin/app_process64 ]; }; then
  OS=android
fi
# Map the machine to the GOARCH the release was built for. The binaries are
# static, so a 32-bit userland on a 64-bit kernel (x86_64 reporting for an i386
# distro, aarch64 for an armhf one) still runs the 64-bit build; what has to be
# right is the kernel, and uname -m reports the kernel's view.
#   armv6l/armv7l/armv8l  32-bit ARM kernels; the arm build is GOARM=6, so it
#                          runs on all of them. armv5 is not served.
#   mips                   both endiannesses report the same name, so the byte
#                          order is read from the ELF header of the shell
#                          itself: byte 5 is 1 on a little-endian build and 2
#                          on a big-endian one. Not `od` — OpenWrt's busybox
#                          does not ship that applet at all.
MACHINE=$(uname -m)
case "$MACHINE" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  i?86|x86) ARCH=386 ;;
  armv6l|armv7l|armv8l|armhf|arm) ARCH=arm ;;
  mips|mipsel|mips64|mips64el)
    case "$(dd if=/bin/sh bs=1 skip=5 count=1 2>/dev/null | tr '\001\002' 'LB')" in
      L) ARCH=mipsle ;;
      B) ARCH=mips ;;
      *) echo "cannot determine MIPS byte order from /bin/sh" >&2; exit 1 ;;
    esac ;;
  *) echo "unsupported architecture: $MACHINE (wanctl ships amd64, arm64, 386, arm, mips and mipsle)" >&2; exit 1 ;;
esac
BIN="wanctl-$OS-$ARCH"

# The manifest is trusted at this point. Extract only the exact platform block
# produced by release-manifest; fail if any field is missing or duplicated.
META=$(awk -v os="$OS" -v arch="$ARCH" '
  /"os":/ { hit=($0 ~ "\"" os "\""); next }
  hit && /"arch":/ { hit=($0 ~ "\"" arch "\""); next }
  hit && /"name":/ { gsub(/[",]/, "", $2); name=$2; next }
  hit && /"size":/ { gsub(/,/, "", $2); size=$2; next }
  hit && /"sha256":/ { gsub(/[",]/, "", $2); print name, size, $2; found++; hit=0 }
  END { if (found != 1) exit 1 }
' "$TMPDIR_WANCTL/manifest.json") || { echo "signed manifest has no unique $OS/$ARCH artifact" >&2; exit 1; }
set -- $META
[ "$#" -eq 3 ] && [ "$1" = "$BIN" ] || { echo "signed artifact identity mismatch" >&2; exit 1; }
SIZE=$2
SHA=$3

curl -fL --proto '=https' --proto-redir '=https' --tlsv1.2 --max-filesize "$SIZE" \
  "$BASE/$BIN" -o "$TMPDIR_WANCTL/$BIN"
ACTUAL_SIZE=$(wc -c <"$TMPDIR_WANCTL/$BIN" | tr -d ' ')
[ "$ACTUAL_SIZE" = "$SIZE" ] || { echo "artifact size mismatch" >&2; exit 1; }
if command -v sha256sum >/dev/null 2>&1; then ACTUAL_SHA=$(sha256sum "$TMPDIR_WANCTL/$BIN" | awk '{print $1}');
else ACTUAL_SHA=$(shasum -a 256 "$TMPDIR_WANCTL/$BIN" | awk '{print $1}'); fi
[ "$ACTUAL_SHA" = "$SHA" ] || { echo "artifact sha256 mismatch" >&2; exit 1; }

# Android has no /usr/local/bin and no sudo, and — more importantly — will not
# execute a binary from most writable locations. $PREFIX/bin is Termux's own
# bin directory, which is both on PATH and executable; outside Termux the only
# reliably executable writable path is /data/local/tmp.
if [ "$OS" = android ]; then
  DEFAULT_DEST=${PREFIX:+$PREFIX/bin/wanctl}
  DEFAULT_DEST=${DEFAULT_DEST:-/data/local/tmp/wanctl}
else
  DEFAULT_DEST=/usr/local/bin/wanctl
fi
DEST=${WANCTL_BIN:-${EXISTING:-$DEFAULT_DEST}}
mkdir -p "$(dirname "$DEST")" 2>/dev/null || true
# cp + chmod + rename rather than `install`, which busybox routers lack. The
# rename is what lets this replace a binary that is currently running.
place() { cp "$1" "$2.new" && chmod 0755 "$2.new" && mv -f "$2.new" "$2"; }
if place "$TMPDIR_WANCTL/$BIN" "$DEST" 2>/dev/null; then :
elif [ "$OS" != android ] && command -v sudo >/dev/null 2>&1; then
  sudo sh -c 'cp "$1" "$2.new" && chmod 0755 "$2.new" && mv -f "$2.new" "$2"' sh "$TMPDIR_WANCTL/$BIN" "$DEST"
else mkdir -p "$HOME/.local/bin"; DEST="$HOME/.local/bin/wanctl"; place "$TMPDIR_WANCTL/$BIN" "$DEST"; fi
echo "verified and installed: $DEST"
case "$OS:$DEST" in
  android:/data/local/tmp/*) echo "note: /data/local/tmp is not on PATH — run it as $DEST" ;;
esac
