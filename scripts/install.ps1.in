# Verifies an RSA signature over the release manifest before installing
# anything. This script ships on the project's release page, independent of any
# relay mirror it may download binaries from.
$ErrorActionPreference = 'Stop'

# Where the artifacts live, flat (manifest.json + binaries side by side).
# Explicit env wins; a relay's /dl mirror next; then the release page this
# installer was built for.
# A relay serving this script rewrites the empty string below to its own public
# origin, so `irm https://relay/install.ps1 | iex` installs from that relay with
# nothing exported. The release build leaves it empty.
$relaySelf = ''
$base = $env:WANCTL_DIST_BASE
if (-not $base) {
  $relay = if ($env:WANCTL_RELAY) { $env:WANCTL_RELAY } else { $relaySelf }
  if ($relay) { $base = $relay.TrimEnd('/') + '/dl' }
  else { $base = '@WANCTL_RELEASE_BASE@' }
}
if (-not $base) {
  $relay = '@WANCTL_DEFAULT_RELAY@'
  if ($relay) { $base = $relay.TrimEnd('/') + '/dl' }
}
if (-not $base) { throw 'set WANCTL_DIST_BASE (or WANCTL_RELAY) to where the release artifacts live' }

# install.sh only ever speaks https (--proto '=https' --proto-redir '=https'
# --tlsv1.2); this installer used to accept any scheme and the OS default TLS
# floor, so the two made different promises (audit 2026-08-28, SEC-F-09).
$baseUri = $null
if (-not [Uri]::TryCreate($base, [UriKind]::Absolute, [ref]$baseUri) -or $baseUri.Scheme -ne 'https') {
  throw "release base must be an https URL: $base"
}
# On .NET Framework (PowerShell 5.1) HttpClient sits on HttpWebRequest and
# honours ServicePointManager. Tls13 is missing from the enum on older
# frameworks and setting it can be refused on older Windows, so fall back to a
# TLS 1.2-only floor rather than to the OS default.
$tlsFloor = [Net.SecurityProtocolType]::Tls12
if ([Enum]::GetNames([Net.SecurityProtocolType]) -contains 'Tls13') {
  $tlsFloor = $tlsFloor -bor [Net.SecurityProtocolType]::Tls13
}
try {
  [Net.ServicePointManager]::SecurityProtocol = $tlsFloor
} catch {
  [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
}

# Verification runs on RSACryptoServiceProvider, which is present in the
# PowerShell 5.1 every Windows ships with. The previous Ed25519 signature had no
# native verifier here at all and required installing OpenSSL first — a
# multi-minute download from a slow origin, when it did not simply time out.
function Test-ReleaseSignature([string]$manifestPath, [string]$signaturePath) {
  $rsa = New-Object System.Security.Cryptography.RSACryptoServiceProvider
  try {
    $rsa.FromXmlString('@WANCTL_RELEASE_RSA_PUBLIC_KEY_XML@')
    $data = [IO.File]::ReadAllBytes($manifestPath)
    $signature = [IO.File]::ReadAllBytes($signaturePath)
    # The 3-argument overload is the .NET Framework one; the 4-argument
    # VerifyData(data, sig, HashAlgorithmName, Padding) is .NET Core only and
    # throws "cannot find an overload" on 5.1.
    return $rsa.VerifyData($data, 'SHA256', $signature)
  } finally {
    $rsa.Dispose()
  }
}

# Which of the three Windows builds this machine runs. The OS word size comes
# first because it decides what can execute at all: a 32-bit Windows on a 64-bit
# CPU can only run the 386 build. On a 64-bit OS the CPU says which 64-bit build:
# Win32_Processor.Architecture is 12 for ARM64 and 9 for x64, and unlike
# PROCESSOR_ARCHITECTURE it is not rewritten for an emulated x64 PowerShell on
# an ARM64 machine — where the env var reads AMD64 and would install the slow
# emulated build on a machine that has a native one. RuntimeInformation is not
# used: on .NET Framework it can only ever answer X86 or X64.
function Get-WindowsGoArch {
  if (-not [Environment]::Is64BitOperatingSystem) { return '386' }
  $cpu = $null
  try { $cpu = (Get-CimInstance -ClassName Win32_Processor -ErrorAction Stop | Select-Object -First 1).Architecture } catch {}
  switch ($cpu) {
    12 { return 'arm64' }
    9 { return 'amd64' }
  }
  $native = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }
  switch -Regex ($native) {
    '^ARM64$' { return 'arm64' }
    '^(AMD64|x64)$' { return 'amd64' }
    '^x86$' { return '386' }
  }
  throw "unsupported Windows architecture: cpu=$cpu env=$native (wanctl ships amd64, 386 and arm64)"
}

function Receive-SizedFile([string]$uri, [string]$path, [int64]$maxBytes) {
  Add-Type -AssemblyName System.Net.Http
  $client = [Net.Http.HttpClient]::new()
  $response = $null
  $inputStream = $null
  $outputStream = $null
  try {
    $response = $client.GetAsync($uri, [Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
    $response.EnsureSuccessStatusCode() | Out-Null
    # RequestUri reflects the final hop after redirects; https→http downgrades
    # are followed by default (audit 2026-08-28, SEC-F-09).
    if ($response.RequestMessage.RequestUri.Scheme -ne 'https') {
      throw "download left https: $($response.RequestMessage.RequestUri)"
    }
    if ($response.Content.Headers.ContentLength -ne $null -and $response.Content.Headers.ContentLength -gt $maxBytes) { throw 'download exceeds signed size limit' }
    $inputStream = $response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
    $outputStream = [IO.File]::Open($path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
    $buffer = New-Object byte[] 65536
    [int64]$total = 0
    while (($count = $inputStream.Read($buffer, 0, $buffer.Length)) -gt 0) {
      $total += $count
      if ($total -gt $maxBytes) { throw 'download exceeds signed size limit' }
      $outputStream.Write($buffer, 0, $count)
    }
  } finally {
    if ($outputStream) { $outputStream.Dispose() }
    if ($inputStream) { $inputStream.Dispose() }
    if ($response) { $response.Dispose() }
    $client.Dispose()
  }
}

$tmpDir = Join-Path $env:TEMP ("wanctl-release-" + [guid]::NewGuid().Guid)
New-Item -ItemType Directory -Path $tmpDir | Out-Null
try {
  $manifestPath = Join-Path $tmpDir 'manifest.json'
  $signaturePath = Join-Path $tmpDir 'manifest.json.rsa.sig'
  Receive-SizedFile "$base/manifest.json" $manifestPath 1048576
  Receive-SizedFile "$base/manifest.json.rsa.sig" $signaturePath 1024
  if (-not (Test-ReleaseSignature $manifestPath $signaturePath)) { throw 'release manifest signature verification failed' }

  $manifest = Get-Content -Raw $manifestPath | ConvertFrom-Json
  $targetVersion = [version]$manifest.version.TrimStart('v')
  $existing = (Get-Command wanctl.exe -ErrorAction SilentlyContinue).Source
  if ($existing) {
    $savedErrorActionPreference = $ErrorActionPreference
    try {
      # Releases before the signed updater did not expose `wanctl version`.
      $ErrorActionPreference = 'SilentlyContinue'
      $currentText = ((& $existing version 2>$null | Out-String).Trim())
      $currentExitCode = $LASTEXITCODE
    } finally {
      $ErrorActionPreference = $savedErrorActionPreference
    }
    if ($currentExitCode -ne 0 -or $currentText -notmatch '^v[0-9]+\.[0-9]+\.[0-9]+$') { $currentText = $null }
    if ($currentText -and $targetVersion -le [version]$currentText.TrimStart('v')) {
      throw "refusing release $($manifest.version): installed version is $currentText"
    }
  }
  $arch = Get-WindowsGoArch
  $artifact = @($manifest.artifacts | Where-Object { $_.os -eq 'windows' -and $_.arch -eq $arch })
  if ($artifact.Count -ne 1 -or $artifact[0].name -ne "wanctl-windows-$arch.exe") { throw "signed manifest has no unique windows/$arch artifact" }
  if ([int64]$artifact[0].size -le 0 -or [int64]$artifact[0].size -gt 67108864) { throw 'signed artifact size is invalid' }
  $binaryPath = Join-Path $tmpDir $artifact[0].name
  Receive-SizedFile "$base/$($artifact[0].name)" $binaryPath ([int64]$artifact[0].size)
  if ((Get-Item $binaryPath).Length -ne [int64]$artifact[0].size) { throw 'artifact size mismatch' }
  if ((Get-FileHash -Algorithm SHA256 $binaryPath).Hash.ToLowerInvariant() -ne $artifact[0].sha256) { throw 'artifact sha256 mismatch' }

  $dest = if ($env:WANCTL_BIN) { $env:WANCTL_BIN } elseif ($existing) { $existing } else { Join-Path $env:LOCALAPPDATA 'wanctl\wanctl.exe' }
  New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dest) | Out-Null
  Move-Item -Force $binaryPath $dest
  Write-Host "verified and installed: $dest"
} finally {
  Remove-Item -Recurse -Force $tmpDir -ErrorAction SilentlyContinue
}
