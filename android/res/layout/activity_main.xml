<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingLeft="24dp"
      android:paddingRight="24dp"
      android:paddingTop="28dp"
      android:paddingBottom="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:textSize="13sp" />

    <TextView style="@style/Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_device" />

    <TextView style="@style/Key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_name" />

    <EditText
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_name"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <TextView style="@style/Key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_status" />

    <TextView
        android:id="@+id/status"
        style="@style/Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <TextView style="@style/Key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_relay" />

    <TextView
        android:id="@+id/relay"
        style="@style/Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView style="@style/Key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_fingerprint" />

    <TextView
        android:id="@+id/fingerprint"
        style="@style/Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <TextView style="@style/Key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_credential" />

    <TextView
        android:id="@+id/credential"
        style="@style/Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView style="@style/Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_control" />

    <Switch
        android:id="@+id/enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/switch_enabled"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/boot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/switch_boot"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/autotrust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/switch_autotrust"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/autotrust_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_autotrust_warn"
        android:textSize="12sp"
        android:visibility="gone" />

    <Switch
        android:id="@+id/bypass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/switch_bypass"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/bypass_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_bypass_warn"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_battery" />

    <Button
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_login" />

    <Button
        android:id="@+id/logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_logs" />

    <Button
        android:id="@+id/update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_update" />

  </LinearLayout>
</ScrollView>
