# Public HTTPS origin of the relay, without a trailing slash.
RELAY_PUBLIC_ORIGIN=https://relay.example.com

# Host loopback port forwarded to the relay container. Usually leave this unchanged.
RELAY_PORT=8080

# Public HTTPS origin of the portal, without a trailing slash.
PORTAL_PUBLIC_ORIGIN=https://portal.example.com

# Host loopback port forwarded to the portal container. Usually leave this unchanged.
PORTAL_PORT=8081

# PostgreSQL database name created by the postgres image.
POSTGRES_DB=wanctl

# PostgreSQL user created by the postgres image.
POSTGRES_USER=wanctl

# PostgreSQL password used by both postgres and relay. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-value

# Shared secret protecting the relay admin API. Generate with: openssl rand -hex 32
WANCTL_ADMIN_SECRET=replace-with-a-random-value

# Client ID from GitHub Settings -> Developer settings -> OAuth Apps -> your OAuth App.
WANCTL_GITHUB_CLIENT_ID=replace-with-github-client-id

# Client secret generated on the same GitHub OAuth App page. Keep it private.
WANCTL_GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# HMAC key for portal login cookies; it must be at least 32 bytes. Generate with: openssl rand -hex 32
WANCTL_SESSION_SECRET=replace-with-a-random-value

# Optional privileged token for the portal's remote device console. Leave empty initially; docs/self-hosting.md explains how to issue it.
WANCTL_PORTAL_TOKEN=

# Go module proxy used while building the image. Only change this when the host
# cannot reach proxy.golang.org (e.g. GOPROXY=https://goproxy.cn,direct).
#GOPROXY=https://proxy.golang.org,direct

# Ed25519 release public key(s), comma-separated raw base64, baked into the
# image at build time so the relay can serve signed releases from ./dist.
# Optional; docs/self-hosting.md ("Serve signed releases to devices") shows how
# to derive the value from a release's release-public.pem.
#WANCTL_RELEASE_PUBLIC_KEYS=
